# KIBOSS Backend Environment Variables
# Copy this file to .env and fill in the values

# Security
SECRET_KEY=generate_a_secure_random_key_here
DEBUG=False
ALLOWED_HOSTS=api.kiboss.example.com,localhost,127.0.0.1

# CORS
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://kiboss.example.com,http://localhost:5173

# Redis & Celery
REDIS_URL=redis://:your_redis_password@localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
CELERY_BROKER_URL=redis://:your_redis_password@localhost:6379/0
CELERY_RESULT_BACKEND=redis://:your_redis_password@localhost:6379/1
